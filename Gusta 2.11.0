// Paste into Wand's DevTools Console before reproducing a trainer launch failure.
// Observes lifecycle events only; refresh/restart Wand to remove the subscriptions.
(() => {
    const guard = '__wandTrainerLaunchDiagnostics';
    if (globalThis[guard]) return console.info('Trainer diagnostics already installed.');
    const chunk = globalThis.webpackChunkWeMod;
    if (!Array.isArray(chunk)) throw new Error('Run this in the main Wand renderer Console.');
    let runtime;
    chunk.push([[`trainer-diagnostics-${Date.now()}`], {}, (value) => { runtime = value; }]);
    if (!runtime?.c) throw new Error('Wand webpack cache is unavailable.');

    const containers = new Set();
    if (globalThis.aurelia?.container) containers.add(globalThis.aurelia.container);
    for (const element of [document.body, ...document.querySelectorAll('*')]) {
        if (element?.__aurelia__?.container) containers.add(element.__aurelia__.container);
        if (element?.au?.container) containers.add(element.au.container);
        for (const entry of Object.values(element?.au ?? {})) {
            const container = entry?.container || entry?.controller?.container
                || entry?.viewModel?.container || entry?.controller?.viewModel?.container;
            if (container) containers.add(container);
        }
    }

    let service;
    for (const record of Object.values(runtime.c)) {
        const exports = record?.exports;
        const candidates = typeof exports === 'function' ? [exports] : Object.values(exports ?? {});
        for (const candidate of candidates) {
            const prototype = candidate?.prototype;
            if (!['launch', 'endTrainer', 'onNewTrainer', 'onTrainerEnded'].every(
                (name) => typeof prototype?.[name] === 'function',
            )) continue;
            for (const container of containers) {
                try { service = container.get(candidate); } catch { continue; }
                if (service) break;
            }
            if (service) break;
        }
        if (service) break;
    }
    if (!service) throw new Error('Trainer service not found. Open the game page and try again.');

    function snapshot(event, trainer) {
        try {
            const error = trainer?.launchError;
            // Deliberately avoid serializing account, store, launch requests or network data.
            const details = {
                event,
                time: new Date().toISOString(),
                backend: trainer?.backend ?? null,
                launchResult: trainer?.launchResult ?? null,
                finalState: trainer?.finalState ?? null,
                launchDuration: trainer?.launchDuration ?? null,
                error: error ? {
                    name: error.name ?? error.constructor?.name ?? null,
                    code: error.code ?? null,
                    message: String(error.message ?? error).slice(0, 2000)
                        .replace(/Bearer\s+\S+/gi, 'Bearer [redacted]')
                        .replace(/([?&](?:token|access_token|key)=)[^&\s]*/gi, '$1[redacted]'),
                } : null,
            };
            console.info('[trainer-diagnostics]', JSON.stringify(details));
        } catch (error) {
            console.warn('[trainer-diagnostics] Could not read trainer status:', error.name);
        }
    }

    const subscriptions = [];
    subscriptions.push(service.onNewTrainer((trainer) => snapshot('created', trainer)));
    subscriptions.push(service.onTrainerEnded((trainer) => snapshot('ended', trainer)));
    globalThis[guard] = { subscriptions };
    console.info('[trainer-diagnostics] Ready. Press Play, then copy the created/ended lines.');
})();

param(
    [Parameter(Mandatory = $true)]
    [string]$Version,

    [string]$OutputPath
)

$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

$repoRoot = Split-Path -Parent $PSScriptRoot
$changelogPath = Join-Path $repoRoot 'CHANGELOG.md'

function Normalize-Version {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) {
        throw 'Version value cannot be empty.'
    }

    # A pre-release tag (1.1.0.0-rc.1) reads the notes of its base version.
    return ($Value.Trim().TrimStart('v', 'V') -replace '-.*$', '')
}

function Get-ChangelogSection {
    param(
        [string]$Content,
        [string]$TargetVersion
    )

    $normalizedTargetVersion = Normalize-Version $TargetVersion
    $normalizedContent = $Content -replace "`r`n", "`n" -replace "`r", "`n"
    $lines = $normalizedContent -split "`n"
    $builder = New-Object System.Text.StringBuilder
    $isInsideSection = $false

    foreach ($line in $lines) {
        $match = [regex]::Match($line, '^##\s+\[(?<version>[^\]]+)\]')
        if ($match.Success) {
            if ($isInsideSection) {
                break
            }

            $isInsideSection = (Normalize-Version $match.Groups['version'].Value) -eq $normalizedTargetVersion
            continue
        }

        if (-not $isInsideSection) {
            continue
        }

        [void]$builder.AppendLine($line)
    }

    return $builder.ToString().Trim()
}

if (-not (Test-Path $changelogPath)) {
    throw "CHANGELOG.md not found: $changelogPath"
}

$changelogContent = Get-Content -Path $changelogPath -Raw
$section = Get-ChangelogSection -Content $changelogContent -TargetVersion $Version

if ([string]::IsNullOrWhiteSpace($section)) {
    throw "Changelog section for version '$(Normalize-Version $Version)' was not found in CHANGELOG.md."
}

if ([string]::IsNullOrWhiteSpace($OutputPath)) {
    Write-Output $section
    exit 0
}

$resolvedOutputPath = if ([System.IO.Path]::IsPathRooted($OutputPath)) {
    $OutputPath
}
else {
    Join-Path $repoRoot $OutputPath
}

Set-Content -Path $resolvedOutputPath -Value $section -Encoding utf8
Write-Host "Wrote changelog section to $resolvedOutputPath"
param(
    [string]$AssemblyPath,
    [string]$AuxiliaryPath,
    [string]$ClientExecutable
)

$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest
$repoRoot = Split-Path -Parent $PSScriptRoot
$scratch = Join-Path ([IO.Path]::GetTempPath()) ('wand-aux-test-' + [guid]::NewGuid().ToString('N'))
[IO.Directory]::CreateDirectory($scratch) | Out-Null

function Assert-Equal($Actual, $Expected, [string]$Message) {
    if ($Actual -ne $Expected) { throw "$Message (expected $Expected, got $Actual)" }
}

function New-Fixture([string]$Path, [string]$Options) {
    $source = Join-Path $PSScriptRoot 'tests/auxiliary-integrity.cs'
    if ($PSVersionTable.PSVersion.Major -ge 6) {
        Add-Type -Path $source -OutputAssembly $Path -CompilerOptions $Options
    }
    else {
        $parameters = New-Object System.CodeDom.Compiler.CompilerParameters
        $parameters.CompilerOptions = $Options
        $parameters.OutputAssembly = $Path
        $parameters.GenerateInMemory = $false
        $parameters.ReferencedAssemblies.Add('System.dll') | Out-Null
        $provider = New-Object Microsoft.CSharp.CSharpCodeProvider
        try {
            $result = $provider.CompileAssemblyFromFile($parameters, $source)
            if ($result.Errors.HasErrors) { throw ($result.Errors | Out-String) }
        }
        finally { $provider.Dispose() }
    }
}

try {
    if ($AssemblyPath) {
        $assembly = [Reflection.Assembly]::LoadFrom((Resolve-Path -LiteralPath $AssemblyPath).Path)
    }
    else {
        # Isolated source checks also run without Visual Studio or a WPF build.
        $sourceAssembly = Join-Path $scratch 'patcher.dll'
        Add-Type -Path @(
            (Join-Path $repoRoot 'WandEnhancer/Core/ELogType.cs'),
            (Join-Path $repoRoot 'WandEnhancer/Core/Patching/Strategies/Static/DotNetImage.cs'),
            (Join-Path $repoRoot 'WandEnhancer/Core/Patching/Strategies/Static/AuxTrustNeutralizer.cs')
        ) -OutputAssembly $sourceAssembly
        $assembly = [Reflection.Assembly]::Load([IO.File]::ReadAllBytes($sourceAssembly))
    }
    $neutralizer = $assembly.GetType('WandEnhancer.Core.Patching.Strategies.Static.AuxTrustNeutralizer', $true)
    $neutralize = $neutralizer.GetMethod('Neutralize')

    foreach ($variant in 'current', 'legacy') {
        $fixture = Join-Path $scratch "$variant.dll"
        $options = if ($variant -eq 'legacy') { '/define:LEGACY' } else { '/optimize+' }
        New-Fixture $fixture $options
        $arguments = [object[]]@([string]$fixture, $null)
        $changed = $neutralize.Invoke($null, $arguments)
        $expected = if ($variant -eq 'current') { 3 } else { 1 }
        Assert-Equal $changed $expected "$variant signature and ASAR patch count"

        # Loading bytes avoids locking fixture files, and executes the actual
        # patched IL so invalid exception-handler/header edits cannot pass.
        $patched = [Reflection.Assembly]::Load([IO.File]::ReadAllBytes($fixture))
        $type = $patched.GetType('AuxiliaryFixture', $true)
        Assert-Equal ($type.GetMethod('SignatureCheck').Invoke($null, $null)) 0 "$variant signature status"
        if ($variant -eq 'current') {
            # Both strategies share this neutralizer now; the signature stub must
            # sit next to the archive and fuse stubs in the same binary.
            $signatureIl = $type.GetMethod('SignatureCheck').GetMethodBody().GetILAsByteArray()
            Assert-Equal ($signatureIl[0] -eq 0x16 -and $signatureIl[1] -eq 0x2A) $true 'Signature check neutralised'
            $result = $type.GetMethod('AsarCheck').Invoke($null, [object[]]@('missing-client'))
            Assert-Equal ([int]$result) 0 'Patched ASAR validation status'
            $result = $type.GetMethod('FuseCheck').Invoke($null, [object[]]@($null, 'missing-client', $null))
            Assert-Equal ([int]$result) 0 'Patched disk/memory fuse validation status'
        }
        Assert-Equal ($type.GetMethod('UnrelatedPath').Invoke($null, $null)) 'resources\app.asar' 'Unrelated path method preserved'
        Assert-Equal ($type.GetMethod('UnrelatedAlgorithm').Invoke($null, $null)) 'SHA256' 'Unrelated algorithm method preserved'
        $hash = (Get-FileHash -LiteralPath $fixture).Hash
        Assert-Equal ($neutralize.Invoke($null, $arguments)) 0 "$variant idempotence"
        Assert-Equal (Get-FileHash -LiteralPath $fixture).Hash $hash "$variant second pass leaves bytes unchanged"
    }

    $unsupported = Join-Path $scratch 'unsupported.dll'
    New-Fixture $unsupported '/define:UNSUPPORTED'
    $originalHash = (Get-FileHash -LiteralPath $unsupported).Hash
    $rejected = $false
    try { $neutralize.Invoke($null, [object[]]@([string]$unsupported, $null)) | Out-Null }
    catch { $rejected = $_.Exception.GetBaseException().Message -eq 'Unrecognised auxiliary ASAR validation signature.' }
    Assert-Equal $rejected $true 'Unsupported ASAR shape fails loudly'
    Assert-Equal (Get-FileHash -LiteralPath $unsupported).Hash $originalHash 'Unsupported service is not partially patched'

    $restructured = Join-Path $scratch 'restructured.dll'
    New-Fixture $restructured '/define:RESTRUCTURED'
    $originalHash = (Get-FileHash -LiteralPath $restructured).Hash
    $rejected = $false
    try { $neutralize.Invoke($null, [object[]]@([string]$restructured, $null)) | Out-Null }
    catch { $rejected = $_.Exception.GetBaseException().Message -eq 'Auxiliary ASAR validation detected but not recognised.' }
    Assert-Equal $rejected $true 'Detected but restructured ASAR validation fails loudly'
    Assert-Equal (Get-FileHash -LiteralPath $restructured).Hash $originalHash 'Restructured service is unchanged'

    if ($AuxiliaryPath) {
        $realCopy = Join-Path $scratch 'real-auxiliary.exe'
        Copy-Item -LiteralPath $AuxiliaryPath -Destination $realCopy
        $changed = $neutralize.Invoke($null, [object[]]@([string]$realCopy, $null))
        # A previously enhanced aux already carries the signature stub: 3 = pristine, 2 = re-enhance.
        if ($changed -ne 2 -and $changed -ne 3) { throw "Real auxiliary patch count unexpected (got $changed)" }
        Assert-Equal ($neutralize.Invoke($null, [object[]]@([string]$realCopy, $null))) 0 'Real auxiliary idempotence'
        $realAssembly = [Reflection.Assembly]::Load([IO.File]::ReadAllBytes($realCopy))
        try { $realTypes = $realAssembly.GetTypes() }
        catch [Reflection.ReflectionTypeLoadException] { $realTypes = $_.Exception.Types | Where-Object { $null -ne $_ } }
        $realValidators = @($realTypes | ForEach-Object {
            $_.GetMethods([Reflection.BindingFlags]'Public,NonPublic,Static,DeclaredOnly')
        } | Where-Object {
            $parameters = $_.GetParameters()
            $isArchive = $parameters.Length -eq 1 -and $parameters[0].ParameterType -eq [string]
            $isFuse = $parameters.Length -eq 3 -and $parameters[1].ParameterType -eq [string]
            if (-not $_.ReturnType.IsEnum -or (-not $isArchive -and -not $isFuse)) { return $false }
            $il = $_.GetMethodBody().GetILAsByteArray()
            return $il.Length -ge 2 -and $il[0] -eq 0x16 -and $il[1] -eq 0x2A
        })
        Assert-Equal $realValidators.Count 2 'Real auxiliary has archive and fuse validators patched'
        foreach ($validator in $realValidators) {
            $arguments = if ($validator.GetParameters().Length -eq 1) { [object[]]@('missing-client') } else { [object[]]@($null, 'missing-client', $null) }
            Assert-Equal ([int]$validator.Invoke($null, $arguments)) 0 'Real auxiliary patched validator executes'
        }
        if ($ClientExecutable) {
            $methods = @($realTypes | ForEach-Object { $_.GetMethods([Reflection.BindingFlags]'Public,NonPublic,Static,DeclaredOnly') })
            $gates = @($methods | Where-Object {
                $p = $_.GetParameters()
                return $_.ReturnType -eq [bool] -and $p.Length -eq 3 -and $p[1].ParameterType -eq [string] -and
                    $p[0].ParameterType.IsClass -and -not $p[0].ParameterType.Namespace -and
                    $p[2].ParameterType.IsClass -and -not $p[2].ParameterType.Namespace
            })
            Assert-Equal $gates.Count 1 'Real auxiliary combined client gate located'
            $verifiedType = $gates[0].GetParameters()[0].ParameterType
            $verifiers = @($methods | Where-Object {
                $p = $_.GetParameters()
                return $_.ReturnType -eq $verifiedType -and $p.Length -eq 1 -and $p[0].ParameterType -eq [string]
            })
            Assert-Equal $verifiers.Count 1 'Real auxiliary signed-file verifier located'
            $verified = $verifiers[0].Invoke($null, [object[]]@([string]$ClientExecutable))
            try {
                # Both patched status methods were executed above. The wrapper
                # stays non-null, but cannot trigger process reads through their
                # early returns. A null wrapper would skip the old fuse check and
                # incorrectly make an archive-only patch appear sufficient.
                $processType = $gates[0].GetParameters()[2].ParameterType
                $process = [Runtime.Serialization.FormatterServices]::GetUninitializedObject($processType)
                Assert-Equal ($gates[0].Invoke($null, [object[]]@($verified, [string]$ClientExecutable, $process))) $true 'Real combined client gate accepts patched executable'
            }
            finally { $verified.Dispose() }
        }
    }
    Write-Host 'Auxiliary regression checks passed (current, legacy, unsupported, executable IL, idempotence).'
}
finally {
    if (([IO.Path]::GetFullPath($scratch)).StartsWith(([IO.Path]::GetFullPath([IO.Path]::GetTempPath())), [StringComparison]::OrdinalIgnoreCase)) {
        Remove-Item -LiteralPath $scratch -Recurse -Force
    }
}

param(
    [Parameter(Mandatory = $true)]
    [string]$AssemblyPath,
    [switch]$ExpectUpdateNotifications
)

$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest
$assembly = [Reflection.Assembly]::LoadFrom((Resolve-Path -LiteralPath $AssemblyPath).Path)
$privateStatic = [Reflection.BindingFlags]'NonPublic, Static'
$privateInstance = [Reflection.BindingFlags]'NonPublic, Instance'

function Assert-Equal($Actual, $Expected, [string]$Message) {
    if ($Actual -ne $Expected) { throw "$Message (expected $Expected, got $Actual)" }
}

$supervisedNamespace = 'WandEnhancer.Core.Patching.Strategies.Supervised'
foreach ($typeName in 'MemoryFuseApplicator', 'ProcessInfo') {
    $type = $assembly.GetType("$supervisedNamespace.$typeName", $true)
    $methods = @($type.GetMethods($privateStatic) | Where-Object { $_.Name -in 'ReadProcessMemory', 'WriteProcessMemory' })
    $expectedMethodCount = if ($typeName -eq 'MemoryFuseApplicator') { 2 } else { 1 }
    Assert-Equal $methods.Count $expectedMethodCount "$typeName native memory methods"
    foreach ($method in $methods) {
        $parameters = $method.GetParameters()
        Assert-Equal $parameters[3].ParameterType ([UIntPtr]) "$typeName.$($method.Name) size"
        Assert-Equal $parameters[4].ParameterType ([UIntPtr].MakeByRefType()) "$typeName.$($method.Name) byte count"
    }
}

$updateNotifier = $assembly.GetType('WandEnhancer.Core.UpdateNotifier', $false)
Assert-Equal ($null -ne $updateNotifier) ([bool]$ExpectUpdateNotifications) 'Compile-time update notifier'
if ($ExpectUpdateNotifications) {
    $isNewerVersion = $updateNotifier.GetMethod('IsNewerVersion', $privateStatic)
    $current = $assembly.GetName().Version
    $newer = [Version]::new($current.Major, $current.Minor, $current.Build, $current.Revision + 1)
    Assert-Equal ($isNewerVersion.Invoke($null, @($newer.ToString()))) $true 'Newer release detection'
    Assert-Equal ($isNewerVersion.Invoke($null, @("v$current"))) $false 'Current release detection'
    Assert-Equal ($isNewerVersion.Invoke($null, @('invalid'))) $false 'Invalid release detection'

    $buildNotificationText = $updateNotifier.GetMethod('BuildNotificationText', $privateStatic)
    $notificationText = $buildNotificationText.Invoke($null, @("### Fixes`n- Fixed launch"))
    Assert-Equal ($notificationText.Contains('Fixed launch')) $true 'Release note notification'

    $appSettings = [Activator]::CreateInstance($assembly.GetType('WandEnhancer.Core.Services.AppSettings', $true))
    Assert-Equal $appSettings.CheckUpdates $true 'Update check default enabled'
    Assert-Equal $appSettings.CheckPrereleases $false 'Prerelease check default disabled'

    $vmType = $assembly.GetType('WandEnhancer.View.MainWindow.MainWindowVm', $true)
    Assert-Equal ($null -ne $vmType.GetProperty('IsUpdateAvailable')) $true 'Header update badge property'
    Assert-Equal ($null -ne $vmType.GetProperty('ShowUpdateCommand')) $true 'Header update badge command'
}

$scratch = Join-Path ([IO.Path]::GetTempPath()) ('wand-desktop-test-' + [guid]::NewGuid().ToString('N'))
$install = Join-Path $scratch 'app-1.0.0'
$resources = Join-Path $install 'resources'
[IO.Directory]::CreateDirectory($resources) | Out-Null

try {
    $enhancerType = $assembly.GetType('WandEnhancer.Core.Enhancer', $true)
    $isPatched = $enhancerType.GetMethod('IsPatched')
    $hasBackup = $enhancerType.GetMethod('HasBackup')
    $backup = Join-Path $resources 'app.asar.backup'
    $unpackedBackup = Join-Path $resources 'app.asar.unpacked.backup'
    $markerName = $enhancerType.GetField('IncompletePatchMarkerFileName', $privateStatic).GetRawConstantValue()
    $marker = Join-Path $resources $markerName
    $asar = Join-Path $resources 'app.asar'
    $unpacked = Join-Path $resources 'app.asar.unpacked'

    $installArgument = [object[]]@([string]$install)
    Assert-Equal ($isPatched.Invoke($null, $installArgument)) $false 'Fresh installation'
    [IO.File]::WriteAllText($backup, 'original archive')
    Assert-Equal ($isPatched.Invoke($null, $installArgument)) $false 'Incomplete backup'
    [IO.Directory]::CreateDirectory($unpackedBackup) | Out-Null
    [IO.File]::WriteAllText((Join-Path $unpackedBackup 'original.txt'), 'original unpacked')
    Assert-Equal ($hasBackup.Invoke($null, $installArgument)) $true 'Complete backup'
    Assert-Equal ($isPatched.Invoke($null, $installArgument)) $true 'Legacy complete backups'
    [IO.File]::WriteAllText($marker, '')
    Assert-Equal ($hasBackup.Invoke($null, $installArgument)) $true 'Restorable unfinished patch'
    Assert-Equal ($isPatched.Invoke($null, $installArgument)) $false 'Unfinished patch'

    $config = [Activator]::CreateInstance($assembly.GetType('WandEnhancer.Models.WeModConfig', $true))
    $config.RootDirectory = $install
    $config.ExecutableName = 'FixtureClient.exe'
    $config.BrandName = 'wand-test-' + [guid]::NewGuid().ToString('N')
    $logType = $assembly.GetType('WandEnhancer.Core.ELogType', $true)
    $loggerType = [Action``2].MakeGenericType([string], $logType)
    $logger = { param($message, $level) } -as $loggerType
    $enhancer = [Activator]::CreateInstance($enhancerType, @($config, $logger))
    $rollback = $enhancerType.GetMethod('RollbackQuietly', $privateInstance)

    [IO.File]::WriteAllText($asar, 'partial archive')
    [IO.Directory]::CreateDirectory($unpacked) | Out-Null
    [IO.File]::WriteAllText((Join-Path $unpacked 'injected.txt'), 'partial injection')
    $rollback.Invoke($enhancer, $null) | Out-Null
    Assert-Equal ([IO.File]::ReadAllText($asar)) 'original archive' 'Rollback archive'
    Assert-Equal ([IO.File]::ReadAllText((Join-Path $unpacked 'original.txt'))) 'original unpacked' 'Rollback unpacked files'
    Assert-Equal (Test-Path (Join-Path $unpacked 'injected.txt')) $false 'Rollback injection removal'
    Assert-Equal ($isPatched.Invoke($null, $installArgument)) $false 'Rolled-back installation'
    Assert-Equal (Test-Path $backup) $true 'Rollback preserves archive backup'
    Assert-Equal (Test-Path $unpackedBackup) $true 'Rollback preserves unpacked backup'

    [IO.File]::Delete($marker)
    Assert-Equal ($isPatched.Invoke($null, $installArgument)) $true 'Completed retry'
    [IO.File]::WriteAllText($marker, '')
    [IO.File]::WriteAllText((Join-Path $scratch 'FixtureClient.exe.stub'), 'original launcher')

    # Restore can only target this fixture's unique process name and scratch Squirrel root.
    Assert-Equal ([Diagnostics.Process]::GetProcessesByName($config.BrandName).Length) 0 'Fixture process isolation'
    $enhancerType.GetMethod('Restore').Invoke($enhancer, $null) | Out-Null
    foreach ($path in $backup, $unpackedBackup, $marker) {
        Assert-Equal (Test-Path $path) $false 'Restore clears patch state'
    }
    Assert-Equal ([IO.File]::ReadAllText((Join-Path $scratch 'FixtureClient.exe'))) 'original launcher' 'Restore launcher'
    Assert-Equal ($isPatched.Invoke($null, $installArgument)) $false 'Restored installation'
    Write-Host 'Desktop regression checks passed (native sizes, backups, rollback, retry state, restore).'
}
finally {
    Remove-Item -LiteralPath $scratch -Recurse -Force
}

param(
    [Parameter(Mandatory = $true)]
    [string]$AssemblyPath,
    [string]$BundleDirectory
)

$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest
$repoRoot = Split-Path -Parent $PSScriptRoot
$assembly = [Reflection.Assembly]::LoadFrom((Resolve-Path -LiteralPath $AssemblyPath).Path)
$configType = $assembly.GetType('WandEnhancer.Core.EnhancerConfig', $true)
$cursorType = $assembly.GetType('WandEnhancer.Core.Js.JsCursor', $true)
$applierType = $assembly.GetType('WandEnhancer.Core.JavaScriptPatchApplier', $true)
$canSearchFile = $applierType.GetMethod('CanSearchFile')
$scratch = Join-Path ([IO.Path]::GetTempPath()) ('wand-locators-' + [guid]::NewGuid().ToString('N'))
[IO.Directory]::CreateDirectory($scratch) | Out-Null
$utf8 = New-Object Text.UTF8Encoding($false)

function Test-Bundles([string]$Name, [IO.FileInfo[]]$Files, [string]$Output) {
    if ($Files.Count -eq 0) { throw "No JavaScript bundles found for $Name" }
    [IO.Directory]::CreateDirectory($Output) | Out-Null
    $sources = @{}
    foreach ($file in $Files) { $sources[$file.Name] = [IO.File]::ReadAllText($file.FullName) }
    $patches = $configType.GetMethod('GetInstance').Invoke($null, @())
    $count = 0

    foreach ($selection in $patches.Values) {
        foreach ($entry in $selection) {
            $applied = $false
            $capability = $false
            foreach ($file in @($sources.Keys)) {
                if (-not $canSearchFile.Invoke($null, @($file, $entry))) { continue }
                $source = $sources[$file]
                foreach ($hint in $entry.CapabilityHints) {
                    if ($source.Contains($hint)) { $capability = $true }
                }
                $hasSearchHint = $false
                foreach ($hint in $entry.SearchHints) {
                    if ($source.Contains($hint)) { $hasSearchHint = $true }
                }
                if (-not $hasSearchHint) { continue }
                $cursor = [Activator]::CreateInstance($cursorType, @($source))
                try {
                    $edits = $entry.Locate.Invoke($cursor)
                }
                catch {
                    throw "$Name / $file / $($entry.Name): $($_.Exception.GetBaseException().Message)"
                }
                if ($null -eq $edits) { continue }
                if ($edits.Length -eq 0) { throw "$($entry.Name) returned no edits" }
                $nextStart = $source.Length
                foreach ($edit in @($edits | Sort-Object Start -Descending)) {
                    if ($edit.Start -lt 0 -or $edit.End -lt $edit.Start -or $edit.End -gt $nextStart) {
                        throw "$($entry.Name) returned overlapping or invalid edits"
                    }
                    $source = $edit.ApplyTo($source)
                    $nextStart = $edit.Start
                }
                $sources[$file] = $source
                $applied = $true
            }
            if (-not $applied -and (-not $entry.IsOptional -or $capability)) {
                throw "$Name did not resolve $($entry.Name)"
            }
            if ($applied) { $count++ }
        }
    }

    foreach ($file in $sources.Keys) {
        $target = Join-Path $Output $file
        [IO.File]::WriteAllText($target, $sources[$file], $utf8)
        & node --check $target
        if ($LASTEXITCODE -ne 0) { throw "$Name produced invalid JavaScript in $file" }
    }
    Write-Host "$Name passed: $count patches, $($sources.Count) parsed bundles."
}

try {
    if ($BundleDirectory) {
        $files = @(Get-ChildItem -LiteralPath $BundleDirectory -Filter '*.js' -File)
        Test-Bundles 'Real bundles' $files (Join-Path $scratch 'patched')
    }
    else {
        $fixture = Join-Path $PSScriptRoot 'tests\patch-locators.js'
        $esbuild = Join-Path $repoRoot 'web-panel\node_modules\esbuild\bin\esbuild'
        foreach ($variant in 'prettified', 'minified') {
            $inputDir = Join-Path $scratch $variant
            [IO.Directory]::CreateDirectory($inputDir) | Out-Null
            $input = Join-Path $inputDir 'index.js'
            $options = @($esbuild, $fixture, '--target=es2022', "--outfile=$input")
            if ($variant -eq 'minified') { $options += '--minify' }
            & node @options
            if ($LASTEXITCODE -ne 0) { throw "Could not generate $variant fixture" }
            Test-Bundles $variant @((Get-Item -LiteralPath $input)) (Join-Path $inputDir 'patched')
        }
    }
}
finally {
    Remove-Item -LiteralPath $scratch -Recurse -Force
}

$assembly = [System.Reflection.Assembly]::LoadFrom((Convert-Path './out/WandEnhancer.exe'))
$type = $assembly.GetType('WandEnhancer.Core.Js.JsCursor')
$text = [string](Get-Content -Raw -Path "scripts/tests/patch-locators.js")
$cursor = [System.Activator]::CreateInstance($type, [object[]]($text))
$cursor.GetType().FullName

using System;
using System.IO;
using System.Runtime.InteropServices;

public enum FixtureIntegrity { Valid, Invalid, Unsupported }

public static class AuxiliaryFixture
{
    [DllImport("wintrust.dll")]
    private static extern uint WinVerifyTrust(IntPtr window, IntPtr action, IntPtr data);

    public static uint SignatureCheck()
    {
        return WinVerifyTrust(IntPtr.Zero, IntPtr.Zero, IntPtr.Zero);
    }

#if !LEGACY
#if UNSUPPORTED
    public static FixtureIntegrity AsarCheck(object client)
#else
    public static FixtureIntegrity AsarCheck(string client)
#endif
    {
        // Start inside a protected region: replacing only the first IL bytes leaves
        // an invalid ret inside try. The patched body must discard the EH sections.
        try
        {
            GC.KeepAlive(client);
#if RESTRUCTURED
            GC.KeepAlive("SHA384");
#else
            GC.KeepAlive("SHA256");
#endif
            var path = Path.Combine(client.ToString(), @"resources\app.asar");
            return File.Exists(path) ? FixtureIntegrity.Valid : FixtureIntegrity.Invalid;
        }
        catch (IOException)
        {
            return FixtureIntegrity.Unsupported;
        }
    }

    public static string IntegrityResource()
    {
        GC.KeepAlive("ElectronAsar");
        return "Integrity";
    }

    public static FixtureIntegrity FuseCheck(FileStream file, string client, FixtureFuseProcess process)
    {
        try
        {
            GC.KeepAlive(client);
            var expected = FixtureFuseImage.Read(file);
            return expected[0] == 1 && process.Read()[0] == expected[0]
                ? FixtureIntegrity.Valid : FixtureIntegrity.Invalid;
        }
        catch (IOException) { return FixtureIntegrity.Unsupported; }
    }
#endif

    public static string UnrelatedPath() { return @"resources\app.asar"; }
    public static string UnrelatedAlgorithm() { return "SHA256"; }
}

#if !LEGACY
public static class FixtureFuseImage
{
    public static byte[] Read(FileStream file)
    {
        if (file == null) throw new InvalidDataException("The Electron fuse sentinel was not found.");
        if (file.ReadByte() != 1) throw new InvalidDataException("The Electron fuse wire is invalid.");
        return new byte[] { 1 };
    }
}

public sealed class FixtureFuseProcess
{
    public byte[] Read() { return new byte[] { 0 }; }
}
#endif

